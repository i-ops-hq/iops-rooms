{
  "name": "iops-rooms",
  "version": "0.4.1",
  "description": "Rooms by I-Ops \u2014 local, inspectable shared rooms for agent sessions",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rooms": "src/cli.js",
    "iops-rooms": "src/cli.js"
  },
  "exports": {
    ".": "./src/store.js"
  },
  "files": [
