{
  "name": "iops-rooms",
  "version": "0.7.4",
  "description": "See who built your project and which AI helped, and share your team's status and AI setups (Claude Code, Codex, Cursor) through your own GitHub. Local, no account, no server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rooms": "src/cli.js",
    "iops-rooms": "src/cli.js"
  },
  "exports": {
    ".": "./src/store.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "skills",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "rooms": "node src/cli.js",
    "mcp": "node src/mcp.js",
    "test": "node --import ./test/env-setup.js --test --test-timeout=90000",
    "live": "node src/cli.js live",
    "smoke:solo": "node scripts/solo-smoke.mjs",
    "smoke:individual": "node scripts/solo-smoke.mjs",
    "smoke:two-device": "node scripts/two-device-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "agents",
    "cursor",
    "rooms",
    "claude-code",
    "codex",
    "github",
    "git",
    "ai-attribution",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-ops-hq/iops-rooms.git"
  },
  "bugs": {
    "url": "https://github.com/i-ops-hq/iops-rooms/issues"
  },
  "homepage": "https://github.com/i-ops-hq/iops-rooms#readme",
  "mcpName": "io.github.i-ops-hq/iops-rooms"
}
